# BolKhata AI - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# WARNING: NEVER commit .env to version control!

# Application Environment
APP_ENV=development
DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
SECRET_KEY=bolkhata-dev-secret-key-change-in-production

# Database (SQLite default for MVP, SQLAlchemy ORM)
DATABASE_URL=sqlite:///./bolkhata.db

# Groq LLM Configuration (for voice command intent parsing & transaction proposals)
# Note: Groq interprets intents only; it NEVER directly writes to the ledger database.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gnani Voice Engine (Verified WebSocket Streaming: Prisma v3.0 STT & Timbre v3.0 TTS)
# Note: Production uses Gnani's active vachana.ai WebSocket streaming interfaces.
GNANI_PRISMA_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TIMBRE_WS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_API_KEY=your_gnani_api_key_here
GNANI_TOKEN=your_gnani_token_here
GNANI_ACCESS_KEY=your_gnani_access_key_here

# Voice & Language Configuration (Kannada, Hindi, English, Natural Code-mixing)
DEFAULT_LANGUAGE=kannada
SUPPORTED_LANGUAGES=["kannada", "hindi", "english"]

# Structured Logging
LOG_LEVEL=INFO
