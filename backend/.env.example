# BolKhata AI - Backend Environment Configuration Template
# Copy this file to backend/.env or root .env
APP_ENV=development
DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
SECRET_KEY=bolkhata-dev-secret-key-change-in-production

# Database (SQLite default for MVP)
DATABASE_URL=sqlite:///./bolkhata.db

# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gnani Voice Engine (Prisma v3.0 STT & Timbre v3.0 TTS WebSocket streaming)
GNANI_PRISMA_WS_URL=wss://api.gnani.ai/v3/prisma/stream
GNANI_TIMBRE_WS_URL=wss://api.gnani.ai/v3/timbre/stream
GNANI_API_KEY=your_gnani_api_key_here
GNANI_TOKEN=your_gnani_token_here
GNANI_ACCESS_KEY=your_gnani_access_key_here

# Voice & Language Configuration
DEFAULT_LANGUAGE=kannada
SUPPORTED_LANGUAGES=["kannada", "hindi", "english"]

# Structured Logging
LOG_LEVEL=INFO
